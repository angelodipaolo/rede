{
  "name": "margin",
  "version": "0.1.0",
  "description": "Local code review command center: review a git diff in the browser and talk to a coding agent in line threads.",
  "type": "module",
  "private": true,
  "bin": {
    "margin": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:server": "esbuild src/cli/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.js --banner:js='#!/usr/bin/env node'",
    "build:web": "vite build web",
    "dev:web": "vite web",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "dompurify": "^3.4.18",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.1",
    "preact": "^11.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
